---
import { getCollection, render } from 'astro:content';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import '../../styles/globals.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<!doctype html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{project.data.title} | Md Shoyeb Rabbi</title>
    <meta name="description" content={project.data.description} />
  </head>
  <body class="antialiased">
    <Navbar client:load />
    <main class="mx-auto min-h-[70vh] max-w-3xl px-4 pb-20 pt-32 sm:px-6">
      <a href="/projects" class="text-sm font-semibold theme-accent-text">&lt;- All projects</a>
      <article class="mt-8">
        <span class="theme-accent-text text-xs font-bold uppercase tracking-widest">{project.data.badge}</span>
        <h1 class="mt-3 text-3xl font-extrabold leading-tight text-gray-900 dark:text-white sm:text-5xl">{project.data.title}</h1>
        {project.data.image && (
          <img src={project.data.image} alt={project.data.title} class="mt-8 aspect-video w-full rounded-xl object-cover" />
        )}
        <p class="mt-6 text-lg leading-relaxed text-gray-600 dark:text-gray-400">{project.data.description}</p>
        <div class="project-content mt-8 text-gray-700 dark:text-gray-300">
          <Content />
        </div>
        <ul class="mt-6 flex flex-wrap gap-2">
          {project.data.tech.map((technology) => (
            <li class="rounded-md bg-gray-100 px-3 py-1.5 text-sm text-gray-700 dark:bg-gray-800 dark:text-gray-300">{technology}</li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          {project.data.liveUrl && project.data.liveUrl !== '#' && (
            <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="theme-btn rounded-lg px-4 py-2.5 text-sm font-semibold">Live project</a>
          )}
          {project.data.githubUrl && project.data.githubUrl !== '#' && (
            <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-gray-300 px-4 py-2.5 text-sm font-semibold text-gray-800 dark:border-gray-700 dark:text-gray-200">Source code</a>
          )}
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .project-content {
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .project-content :global(p) {
    margin: 1.25rem 0;
  }

  .project-content :global(h2),
  .project-content :global(h3) {
    margin: 2rem 0 0.75rem;
    color: #0f172a;
    font-weight: 700;
  }

  .project-content :global(h2) {
    font-size: 1.5rem;
  }

  .project-content :global(h3) {
    font-size: 1.25rem;
  }

  :global(.dark) .project-content :global(h2),
  :global(.dark) .project-content :global(h3) {
    color: #f8fafc;
  }
</style>
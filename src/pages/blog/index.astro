---
import { getCollection } from 'astro:content';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import '../../styles/globals.css';

const posts = (await getCollection('blogs')).sort(
  (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);
---

<!doctype html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog | Md Shoyeb Rabbi</title>
    <meta name="description" content="Technical notes and case studies by Md Shoyeb Rabbi." />
  </head>
  <body class="antialiased">
    <Navbar client:load />
    <main class="mx-auto min-h-[70vh] max-w-5xl px-4 pb-20 pt-32 sm:px-6">
      <header class="mb-12 border-b border-gray-200 pb-8 dark:border-gray-800">
        <p class="theme-accent-text text-xs font-bold uppercase tracking-widest">Notes & Case Studies</p>
        <h1 class="mt-3 text-4xl font-extrabold text-gray-900 dark:text-white sm:text-5xl">Blog</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-gray-600 dark:text-gray-400">
          Practical writing on data, systems, and networking.
        </p>
      </header>

      {posts.length > 0 ? (
        <div class="divide-y divide-gray-200 dark:divide-gray-800">
          {posts.map((post) => (
            <article class="py-7 first:pt-0">
              {post.data.image && (
                <a href={`/blog/${post.id.replace(/\.md$/, '')}`} class="mb-5 block overflow-hidden rounded-xl">
                  <img src={post.data.image} alt={post.data.title} class="max-h-80 w-full object-cover" />
                </a>
              )}
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
                <time datetime={new Date(post.data.date).toISOString()}>
                  {new Date(post.data.date).toLocaleDateString('en', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <span aria-hidden="true">/</span>
                <span class="theme-accent-text font-semibold">{post.data.tag}</span>
              </div>
              <h2 class="mt-3 text-2xl font-bold text-gray-900 dark:text-white">
                <a class="hover:text-cyan-600 dark:hover:text-cyan-400" href={`/blog/${post.id.replace(/\.md$/, '')}`}>
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 max-w-3xl leading-relaxed text-gray-600 dark:text-gray-400">
                {post.data.summary}
              </p>
              <a class="mt-4 inline-flex text-sm font-semibold theme-accent-text" href={`/blog/${post.id.replace(/\.md$/, '')}`}>
                Read article <span aria-hidden="true" class="ml-1">-&gt;</span>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-gray-600 dark:text-gray-400">No articles have been published yet.</p>
      )}
    </main>
    <Footer />
  </body>
</html>
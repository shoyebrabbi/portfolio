---
import { getCollection } from 'astro:content';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import Projects from '../../components/Projects';
import Certificates from '../../components/Certificates';
import siteContent from '../../data/siteContent.json';
import '../../styles/globals.css';

export async function getStaticPaths() {
  const pages = (await getCollection('pages')).filter((page) => page.data.visible);
  return pages.map((page) => ({
    params: { slug: page.id.replace(/\.md$/, '') },
    props: { page },
  }));
}

const { page } = Astro.props;
const projects = (await getCollection('projects'))
  .filter((project) => project.data.visible)
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ id, data }) => ({ id, ...data }));
const certificates = (await getCollection('certificates'))
  .filter((certificate) => certificate.data.visible)
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ id, data }) => ({ id, ...data }));

function getVideoEmbedUrl(rawUrl?: string | null) {
  if (!rawUrl) return null;

  try {
    const url = new URL(rawUrl);
    const host = url.hostname.toLowerCase();
    const youtubeId = host === 'youtu.be'
      ? url.pathname.slice(1)
      : ['youtube.com', 'www.youtube.com', 'm.youtube.com', 'www.youtube-nocookie.com'].includes(host)
        ? url.searchParams.get('v') || url.pathname.match(/\/(?:embed|shorts)\/([^/]+)/)?.[1]
        : null;

    if (youtubeId && /^[\w-]{11}$/.test(youtubeId)) {
      return `https://www.youtube-nocookie.com/embed/${youtubeId}`;
    }

    if (host === 'vimeo.com' || host === 'www.vimeo.com' || host === 'player.vimeo.com') {
      const vimeoId = url.pathname.match(/\/(?:video\/)?(\d+)/)?.[1];
      if (vimeoId) return `https://player.vimeo.com/video/${vimeoId}`;
    }
  } catch {
    return null;
  }

  return null;
}
---

<!doctype html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{page.data.title} | Md Shoyeb Rabbi</title>
    <meta name="description" content={page.data.description || page.data.title} />
  </head>
  <body class="antialiased">
    <Navbar client:load />
    <main class="mx-auto min-h-[70vh] max-w-5xl px-4 pb-20 pt-32 sm:px-6">
      <a href="/pages" class="text-sm font-semibold theme-accent-text">&lt;- All pages</a>
      <header class="mb-10 mt-7 border-b border-gray-200 pb-8 dark:border-gray-800">
        <h1 class="text-4xl font-extrabold text-gray-900 dark:text-white sm:text-5xl">{page.data.title}</h1>
        {page.data.description && <p class="mt-4 max-w-3xl leading-relaxed text-gray-600 dark:text-gray-400">{page.data.description}</p>}
      </header>
      <div class="space-y-12">
        {page.data.sections.filter((section) => section.enabled).map((section, index) => {
          const key = `${section.type}-${index}`;

          if (section.type === 'text') {
            return (
              <section class="mx-auto max-w-3xl" key={key}>
                {section.heading && <h2 class="mb-3 text-2xl font-bold text-gray-900 dark:text-white">{section.heading}</h2>}
                {section.body && <p class="whitespace-pre-line leading-relaxed text-gray-700 dark:text-gray-300">{section.body}</p>}
              </section>
            );
          }

          if (section.type === 'image') {
            return section.image ? (
              <figure key={key}>
                <img src={section.image} alt={section.imageAlt || section.heading || page.data.title} class="mx-auto max-h-[70vh] w-full rounded-xl object-contain" loading="lazy" />
                {section.heading && <figcaption class="mt-3 text-center text-sm text-gray-500">{section.heading}</figcaption>}
              </figure>
            ) : null;
          }

          if (section.type === 'gallery') {
            return section.galleryImages.length > 0 ? (
              <section key={key}>
                {section.heading && <h2 class="mb-5 text-2xl font-bold text-gray-900 dark:text-white">{section.heading}</h2>}
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {section.galleryImages.map((item, imageIndex) => (
                    <figure class="min-w-0" key={`${item.image}-${imageIndex}`}>
                      <img src={item.image} alt={item.alt || item.caption || page.data.title} class="aspect-[4/3] w-full rounded-xl object-cover" loading="lazy" />
                      {item.caption && <figcaption class="mt-2 text-sm text-gray-500 dark:text-gray-400">{item.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              </section>
            ) : null;
          }

          if (section.type === 'quote') {
            return section.body ? (
              <figure class="mx-auto max-w-3xl border-l-4 border-cyan-500 pl-6 py-2" key={key}>
                {section.heading && <figcaption class="mb-2 text-xs font-bold uppercase text-gray-500">{section.heading}</figcaption>}
                <blockquote class="text-xl font-medium leading-relaxed text-gray-800 dark:text-gray-200">{section.body}</blockquote>
                {section.quoteAttribution && <figcaption class="mt-4 text-sm text-gray-500 dark:text-gray-400">{section.quoteAttribution}</figcaption>}
              </figure>
            ) : null;
          }

          if (section.type === 'video') {
            const embedUrl = getVideoEmbedUrl(section.videoUrl);
            return embedUrl ? (
              <section key={key}>
                {section.heading && <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">{section.heading}</h2>}
                <div class="aspect-video overflow-hidden rounded-xl bg-black">
                  <iframe src={embedUrl} title={section.heading || `${page.data.title} video`} class="h-full w-full" loading="lazy" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                </div>
              </section>
            ) : null;
          }

          if (section.type === 'faq') {
            return section.faqs.length > 0 ? (
              <section class="mx-auto max-w-3xl" key={key}>
                {section.heading && <h2 class="mb-5 text-2xl font-bold text-gray-900 dark:text-white">{section.heading}</h2>}
                <div class="divide-y divide-gray-200 border-y border-gray-200 dark:divide-gray-800 dark:border-gray-800">
                  {section.faqs.map((faq, faqIndex) => (
                    <details class="py-4" key={`${faq.question}-${faqIndex}`}>
                      <summary class="cursor-pointer font-semibold text-gray-900 marker:text-cyan-600 dark:text-white">{faq.question}</summary>
                      <p class="mt-3 whitespace-pre-line leading-relaxed text-gray-600 dark:text-gray-400">{faq.answer}</p>
                    </details>
                  ))}
                </div>
              </section>
            ) : null;
          }

          if (section.type === 'projects') {
            return <Projects key={key} projects={projects} labels={siteContent.labels} client:load />;
          }

          if (section.type === 'certificates') {
            return <Certificates key={key} certificates={certificates} labels={siteContent.labels} client:load />;
          }

          return (
            <section key={key} class="theme-card mx-auto max-w-3xl rounded-2xl border p-7 text-center">
              {section.heading && <h2 class="text-2xl font-bold text-gray-900 dark:text-white">{section.heading}</h2>}
              {section.body && <p class="mt-3 whitespace-pre-line text-gray-600 dark:text-gray-400">{section.body}</p>}
              {section.buttonLabel && section.buttonUrl && (
                <a href={section.buttonUrl} class="theme-btn mt-5 inline-flex rounded-lg px-5 py-3 text-sm font-semibold">{section.buttonLabel}</a>
              )}
            </section>
          );
        })}
      </div>
    </main>
    <Footer />
  </body>
</html>